#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <scroll-snap.dtsi>
#include <xy-to-arrows.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <2>;
        map = <
        RC(0,3) RC(0,2)
        RC(0,5) RC(0,4)
        >;
    };

    combos {
        compatible = "zmk,combos";

        /* В слоях 0 (SCROLL) и 1 (TEXT): обе кнопки вместе = вход в режим запасной мыши (MOUSE) */
        combo_to_mouse {
            key-positions = <0 1>;
            layers = <0 1>;
            bindings = <&to 2>;
        };

        /* В слоях 2 (MOUSE) и 3 (SNIPER): клик обеих = СКМ (MB3), удержание 250 мс = возврат в 0 (SCROLL) */
        combo_mouse_mb3_or_scroll {
            key-positions = <0 1>;
            layers = <2 3>;
            bindings = <&hold_to_tap_mkp 0 MB3>;
        };
    };

    behaviors {
        adj1: adj1 {
            compatible = "zmk,behavior-tap-dance";
            label = "ADJ1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;
        };

        adj2: adj2 {
            compatible = "zmk,behavior-tap-dance";
            label = "ADJ2";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_CLR_ALL>;
        };

        hold_mo_tap_mkp: hold_mo_tap_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_MO_TAP_MKP";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-while-undecided-linger;
        };

        hold_to_tap_mkp: hold_to_tap_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TO_TAP_MKP";
            bindings = <&to>, <&mkp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Слой 0 (SCROLL, старт): pos 0 (правая кнопка) = &to 0, pos 1 (левая кнопка) = &to 1 (TEXT) */
        scroll_base {
            bindings = <
&to 0  &to 1
&adj1  &adj2
            >;

            display-name = "Scroll";
        };

        /* Слой 1 (TEXT, 4-way стрелки): pos 0 (правая) = &to 0 (SCROLL), pos 1 (левая) = &to 1 */
        text_arrows {
            bindings = <
&to 0   &to 1
&trans  &trans
            >;

            display-name = "Text";
        };

        /* Слой 2 (MOUSE, запасная мышь): pos 0 (правая) = ПКМ / удержание SNIPER, pos 1 (левая) = ЛКМ */
        mouse {
            bindings = <
&hold_mo_tap_mkp 3 MB2  &mkp MB1
&trans                  &trans
            >;

            display-name = "Mouse";
        };

        /* Слой 3 (SNIPER, 1/4 скорости поверх MOUSE) */
        sniper {
            bindings = <
&trans  &trans
&trans  &trans
            >;

            display-name = "Sniper";
        };
    };
};

&trackball { cpi = <1000>; };

&trackball_listener {
    /* По умолчанию (Слой 0: SCROLL): плавный 2D-скролл */
    input-processors =
        <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
        <&zip_xy_scaler 1 32>,
        <&zip_xy_to_scroll_mapper &zip_scroll_snap>;

    /* Слой 1 (TEXT): 4-позиционные стрелки с поглощением движения курсора */
    text {
        layers = <1>;
        input-processors = <&zip_xy_to_arrows &zip_xy_scaler 0 1>;
    };

    /* Важно: sniper (Слой 3) стоит выше mouse (Слой 2), чтобы работать поверх включённого Слоя 2 */
    sniper {
        layers = <3>;
        input-processors = <&zip_xy_scaler 1 4>;
    };

    /* Слой 2 (MOUSE): курсор мыши */
    mouse {
        layers = <2>;
        input-processors = <&zip_xy_scaler 9 20>;
    };
};
